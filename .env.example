# ===== Frontend (browser-safe) -> put these in web/js/config.js =====
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY
SITE_URL=https://your-site.example.com
PRIVACY_POLICY_URL=#   # provide later

# ===== Edge Function secrets (SERVER ONLY, never in frontend) =====
# Set with:  supabase secrets set --env-file ./.env.secrets
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase; do not set them yourself.
PAYTM_MID=YOUR_PAYTM_MERCHANT_ID
PAYTM_MERCHANT_KEY=YOUR_PAYTM_MERCHANT_KEY      # 16 characters
PAYTM_WEBSITE=WEBSTAGING                         # WEBPROD in production
PAYTM_ENV=staging                                # staging | production
SITE_URL=https://your-site.example.com           # where paytm-callback redirects users
CRON_SECRET=generate-a-long-random-string
